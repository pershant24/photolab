# `engines` in package.json is advisory unless this is set: npm prints a warning
# and installs anyway. A declared constraint that nothing enforces is decoration,
# and this repository already treats environment divergence as a live risk — see
# the SwiftShader backend note in tests/README.md.
#
# Node 22 is what .nvmrc pins, what CI installs, and therefore the only version
# any of this is actually verified on. Run `fnm use` (or `nvm use`) after a
# fresh clone; without it, `npm ci` on Node 23 or later now fails with a clear
# message instead of succeeding and diverging quietly from CI.
#
# This gates `npm install` and `npm ci` only. `npm run` is unaffected, so an
# existing tree keeps working on another version until it is next installed.
engine-strict=true
